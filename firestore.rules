rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    match /profiles/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow create: if request.auth != null
                    && request.auth.uid == userId
                    && request.resource.data.uid == request.auth.uid
                    && request.resource.data.email is string
                    && request.resource.data.email.size() < 256
                    && request.resource.data.name is string
                    && request.resource.data.name.size() < 128
                    && request.resource.data.cloudEmail is string
                    && request.resource.data.authProvider == 'firebase';
      allow update: if (request.auth != null && request.auth.uid == userId)
                    || (request.auth != null
                        && request.resource.data.keys().hasAll(['status'])
                        && request.resource.data.keys().size() <= 4
                        && get(/databases/$(database)/documents/admins/$(request.auth.uid)).exists);
      allow delete: if false;
    }

    match /credentials/{credentialId} {
      allow get: if true;
      allow list: if false;
      allow create: if request.auth != null
                    && request.resource.data.profileId == request.auth.uid
                    && request.resource.data.uid == request.auth.uid
                    && request.resource.data.credential is string
                    && request.resource.data.type in ['email','username','phone','whatsapp'];
      allow update, delete: if false;
    }

    match /businesses/{businessId} {
      allow read: if true;
      allow create: if request.auth != null
                    && request.resource.data.name is string
                    && request.resource.data.name.size() < 128
                    && request.resource.data.ownerId == request.auth.uid;
      allow update: if request.auth != null && request.auth.uid == resource.data.ownerId;
      allow delete: if false;
    }

    match /submitted_areas/{areaId} {
      allow read: if true;
      allow create: if request.auth != null;
      allow update, delete: if false;
    }

    match /brand_registry/{brandId} {
      allow read: if true;
      allow create: if request.auth != null;
      allow update: if false;
      allow delete: if false;
    }

    match /admins/{userId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
                    && request.auth.uid == userId;
      allow delete: if request.auth != null
                    && request.auth.uid == userId
                    && get(/databases/$(database)/documents/admins/$(request.auth.uid)).exists;
      allow update: if false; // Admin roles are not updated
    }

    match /flagged_content/{docId} {
      allow create: if request.auth != null;
      allow read: if request.auth != null
                   && (request.auth.uid == resource.data.reportedBy
                       || get(/databases/$(database)/documents/admins/$(request.auth.uid)).exists);
      allow update, delete: if request.auth != null
                            && get(/databases/$(database)/documents/admins/$(request.auth.uid)).exists;
    }

    match /audit_log/{docId} {
      allow create: if request.auth != null;
      allow read: if request.auth != null
                  && get(/databases/$(database)/documents/admins/$(request.auth.uid)).exists;
      allow update, delete: if false;
    }

    match /error_logs/{docId} {
      allow create: if request.auth != null;
      allow read: if request.auth != null
                  && get(/databases/$(database)/documents/admins/$(request.auth.uid)).exists;
      allow update, delete: if false;
    }

    match /feedback/{docId} {
      allow create: if request.auth != null
                    && request.resource.data.message is string
                    && request.resource.data.message.size() < 2000;
      allow read: if request.auth != null
                  && (request.auth.uid == resource.data.userId
                      || get(/databases/$(database)/documents/admins/$(request.auth.uid)).exists);
      allow update: if request.auth != null
                    && get(/databases/$(database)/documents/admins/$(request.auth.uid)).exists;
      allow delete: if false;
    }

    match /promo_requests/{docId} {
      allow create: if request.auth != null
                    && request.resource.data.userId == request.auth.uid;
      allow read: if request.auth != null
                  && (request.auth.uid == resource.data.userId
                      || get(/databases/$(database)/documents/admins/$(request.auth.uid)).exists);
      allow update: if request.auth != null
                    && get(/databases/$(database)/documents/admins/$(request.auth.uid)).exists;
      allow delete: if false;
    }

    match /payment_requests/{docId} {
      allow create: if request.auth != null;
      allow read: if request.auth != null
                  && (request.auth.uid == resource.data.userId
                      || get(/databases/$(database)/documents/admins/$(request.auth.uid)).exists);
      allow update: if request.auth != null
                    && get(/databases/$(database)/documents/admins/$(request.auth.uid)).exists;
      allow delete: if false;
    }

    match /artwork_submissions/{docId} {
      allow create: if request.auth != null;
      allow read: if request.auth != null
                  && (request.auth.uid == resource.data.userId
                      || get(/databases/$(database)/documents/admins/$(request.auth.uid)).exists);
      allow update: if request.auth != null
                    && get(/databases/$(database)/documents/admins/$(request.auth.uid)).exists;
      allow delete: if false;
    }

    match /push_subscriptions/{userId} {
      allow read: if request.auth != null
                  && (request.auth.uid == userId
                      || get(/databases/$(database)/documents/admins/$(request.auth.uid)).exists);
      allow create, update: if request.auth != null && request.auth.uid == userId;
      allow delete: if request.auth != null
                    && get(/databases/$(database)/documents/admins/$(request.auth.uid)).exists;
    }

    match /push_notifications/{docId} {
      allow create: if request.auth != null;
      allow read: if request.auth != null
                  && get(/databases/$(database)/documents/admins/$(request.auth.uid)).exists;
      allow update, delete: if false;
    }

    match /onboarding_requests/{docId} {
      allow create: if request.auth != null;
      allow read: if request.auth != null
                  && (request.auth.uid == resource.data.userId
                      || get(/databases/$(database)/documents/admins/$(request.auth.uid)).exists);
      allow update: if request.auth != null
                    && get(/databases/$(database)/documents/admins/$(request.auth.uid)).exists;
      allow delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
