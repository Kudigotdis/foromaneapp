# Firebase Cloud Functions environment variables
# Copy this file to .env and fill in the values, then:
#   firebase functions:config:set whatsapp.api_token="your-token" whatsapp.phone_number_id="your-id"
#   firebase functions:config:set push.vapid_public_key="your-key" push.vapid_private_key="your-key"

# WhatsApp Business API (optional — for future server-side WhatsApp integration)
WHATSAPP_API_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# Web Push VAPID keys (for push notifications)
# Generate at: https://web-push-codelab.glitch.me/
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
